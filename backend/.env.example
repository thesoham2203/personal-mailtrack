# Application Environment: development | production | test
APP_ENV=development

# Base URLs (Configurable - No domain required initially)
API_BASE_URL=http://localhost:8000
TRACKING_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:5173

# Database Connection
# Local development default: Async SQLite
DATABASE_URL=sqlite+aiosqlite:///./mailtrack.db
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Tracking & Cryptography
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TRACKING_SIGNING_KEY=change-this-to-a-secure-32-byte-hex-key-in-production
TRACKING_PREVIOUS_KEYS=
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-fernet-key-or-hex

# Google OAuth (Optional for initial tracking, required for Gmail API sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback

# Privacy & Retention
PRIVACY_MODE=true
EVENT_RETENTION_DAYS=90
TRACKING_PREPARE_TIMEOUT_MS=2500

# Feature Flags
DEMO_MODE=false
FEATURE_CAMPAIGNS=true
FEATURE_DOCUMENTS=true
FEATURE_SIGNATURES=true
FEATURE_POLLS=true
FEATURE_VIDEO=true
FEATURE_WEBHOOKS=true
FEATURE_AI=false
